nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        options "-stub-run"

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert new File("$outputDir/arcashla/extracted/RNA_SAMPLE_1.mhc_1.fq.gz").size() > 0 },
                { assert new File("$outputDir/arcashla/extracted/RNA_SAMPLE_1.mhc_2.fq.gz").size() > 0 },
                // ARCASHLA_EXTRACT's own previously-undeclared intermediate
                // (HLA-region-restricted, primary-alignment-only,
                // name-sorted BAM slice), now a declared output, published
                // as a side effect and consumed directly by
                // COUNTS_COMMONREF_HLA below - exercised here via
                // ARCASHLA_EXTRACT's real (unstubbed) script, same as the
                // FASTQ outputs above.
                { assert new File("$outputDir/arcashla/extracted/RNA_SAMPLE_1.mhc.namesort.bam").size() > 0 },
                { assert new File("$outputDir/arcashla/validation/RNA_SAMPLE_1.validatefastq.log").text.contains('no errors found') },
                { assert new File("$outputDir/arcashla/genotype/RNA_SAMPLE_1.genotype.json").exists() },
                { assert new File("$outputDir/arcashla/genotype/RNA_SAMPLE_1.genotype.log").exists() },
                { assert new File("$outputDir/arcashla/arcasHLA_combined.csv").exists() },
                // Mandatory chain (ARCASHLA -> HLA_CONSENSUS -> HLAPM -> HLAPM_STAR_INDEX -> HLAPM_STAR_ALIGN)
                // runs unconditionally - --rna_samples and --sample_key are required parameters, and
                // --wgs_samples does not gate any of it. Exercised here in stub form via -profile test's
                // header-only sample key/HLA-LA placeholder and placeholder --hlapm_repo.
                { assert new File("$outputDir/hla_consensus/hla_consensus.rna_wgs_hla_consensus.tsv").exists() },
                { assert new File("$outputDir/hla_consensus/hla_consensus.rna_wgs_rna-hla_with_consensus.tsv").text.contains('RNA_ONLY:RNA_SAMPLE_1') },
                { assert !new File("$outputDir/hlapm/input").listFiles({ f -> f.name.endsWith('.tsv') } as FileFilter).toList().isEmpty() },
                { assert !new File("$outputDir/hlapm/personalized_ref/out").listFiles().toList().isEmpty() },
                { assert new File("$outputDir/hlapm/star_index_targets/sample_alleles.csv").exists() },
                { assert !new File("$outputDir/hlapm/star_index").listFiles().toList().isEmpty() },
                { assert new File("$outputDir/hlapm/star_align/rna_sample_alleles.csv").exists() },
                { assert !new File("$outputDir/hlapm/star_align/RNA_SAMPLE_1").listFiles().toList().isEmpty() },
                // HLAPM_STAR_QUANTIFY: queryname-sort + cohort-wide combined GTF +
                // per-sample edit-distance quantification, exercised here in stub
                // form via HLAPM_QUANTIFY_READS's stub: block and samtools/sort's
                // own vendored stub: block.
                { assert new File("$outputDir/hlapm/star_align/RNA_SAMPLE_1/placeholder_allele__96008200/RNA_SAMPLE_1.placeholder_allele__96008200.queryname.bam").exists() },
                { assert new File("$outputDir/hlapm/quantify/combined.gtf").size() > 0 },
                { assert new File("$outputDir/hlapm/quantify/RNA_SAMPLE_1/RNA_SAMPLE_1.edit_distance.tsv").size() > 0 },
                { assert new File("$outputDir/hlapm/quantify/RNA_SAMPLE_1/RNA_SAMPLE_1.stat.txt").exists() },
                { assert new File("$outputDir/hlapm/quantify/RNA_SAMPLE_1/RNA_SAMPLE_1.HLA_gene_summary.tsv").size() > 0 },
                // GTF_HLA_GENE_ID_CHECK: run on every launchable run (--gtf is
                // a required parameter), before any counting/reconciliation
                // output exists. Exercised here via its REAL script - the
                // module deliberately has no stub: block - against
                // -profile test's placeholder.gtf, which has no HLA-region and
                // no HLA--prefixed gene, so the check passes with a
                // "0 genes overlap --hla_region" warning and a header-only
                // report.
                { assert new File("$outputDir/gtf_hla_gene_id_check/hla_region_gene_id_map.tsv").text.readLines() == ['gene_name\tgene_ids\tn_gene_ids\tin_region\thla_prefixed\tstatus'] },
                // COUNTS_COMMONREF: whole-genome featureCounts run once per
                // RNA sample against its original BAM + --gtf, independent
                // of --sample_key/HLApm, exercised here in stub form via
                // SUBREAD_FEATURECOUNTS's own vendored stub: block.
                { assert new File("$outputDir/counts_commonref/RNA_SAMPLE_1/RNA_SAMPLE_1.featureCounts.tsv").exists() },
                { assert new File("$outputDir/counts_commonref/RNA_SAMPLE_1/RNA_SAMPLE_1.featureCounts.tsv.summary").exists() },
                // COUNTS_COMMONREF_HLA: iteration 2 of "hijack original count
                // matrix" - featureCounts -R BAM run once per RNA sample
                // against ARCASHLA_EXTRACT's HLA-region BAM (above) + --gtf,
                // reformatted into a per-read gene-assignment TSV. Exercised
                // here in stub form via SUBREAD_FEATURECOUNTS_HLA's own
                // vendored stub: block (touching a placeholder
                // *.featureCounts.bam) and COUNTS_COMMONREF_HLA_REFORMAT's
                // own stub: block (since its real script would otherwise
                // need to parse that stubbed placeholder's content).
                { assert new File("$outputDir/counts_commonref_hla/RNA_SAMPLE_1/RNA_SAMPLE_1.rnaseq_featurecounts.tsv").exists() },
                { assert new File("$outputDir/counts_commonref_hla/RNA_SAMPLE_1/RNA_SAMPLE_1.rnaseq_featurecounts.tsv").text.contains('read_name\tdirection\tgene_name\tedit_distance') },
                // HLA_READCOUNT_RECONCILE: iteration 3 of "hijack original
                // count matrix" - reconciles counts_commonref_hla's per-read
                // gene-assignment table (above) against HLAPM_STAR_QUANTIFY's
                // own per-read edit_distance.tsv (above), producing a
                // per-gene diff table. Only produced here because
                // RNA_SAMPLE_1 is resolved through --sample_key/HLApm to a
                // personalized allele (exercised in stub form via
                // HLA_READCOUNT_RECONCILE_DIFF's own stub: block, since its
                // real script would otherwise need to parse
                // HLAPM_QUANTIFY_READS' non-HLA-prefixed stub content).
                { assert new File("$outputDir/hla_readcount_reconcile/RNA_SAMPLE_1/RNA_SAMPLE_1.hla_readcount_reconcile.tsv").text.contains('gene_id\tgene_name\tcategory\toriginal_fc_count\tpersonalized_count\tdiff') },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_hlarnaseq_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }

    test("reject duplicate RNA IDs") {

        config "../conf/test.config"

        when {
            params {
                rna_samples = "$projectDir/tests/fixtures/rna_samples_duplicate.csv"
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('Duplicate rna_id values are not allowed: RNA_SAMPLE_1') } }
            )
        }
    }

    test("reject invalid RNA header") {

        config "../conf/test.config"

        when {
            params {
                rna_samples = "$projectDir/tests/fixtures/rna_samples_bad_header.csv"
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('Header must be exactly: rna_id,bam,bai,unpaired_r1,unpaired_r2') } }
            )
        }
    }

    test("require HLA region") {

        config "../conf/test.config"

        when {
            params {
                hla_region = null
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('Validation of pipeline parameters failed!') } }
            )
        }
    }

    test("require GTF") {

        // --gtf is an unconditional nf-schema `required` parameter (it used to
        // be enforced by a Groovy check keyed off --rna_samples), so omitting
        // it must fail with nf-schema's standard message before any task runs.
        config "../conf/test.config"

        when {
            params {
                gtf = null
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('Validation of pipeline parameters failed!') } },
                // nf-schema writes the invalid-input detail to stderr, not stdout.
                { assert workflow.stderr.any { it.contains('Missing required parameter(s): gtf') } }
            )
        }
    }

    test("-profile test fails when --gtf has a duplicated HLA-region gene name") {

        // GTF_HLA_GENE_ID_CHECK has no stub: block, so this exercises the
        // real check even under -stub-run. Only --gtf is overridden; every
        // other input stays as conf/test.config sets it, which is the point -
        // there is no configuration a user can pick that skips this check.
        options "-stub-run"

        config "../conf/test.config"

        when {
            params {
                gtf    = "$projectDir/tests/fixtures/gtf_hla_gene_id_check/mhc_duplicate.gtf"
                outdir = "$outputDir"
            }
        }

        then {
            // At pipeline level nf-test leaves workflow.errorReport empty for
            // a task failure (unlike a process-level test); the task's
            // "Command error:" block, and with it the full offender list, is
            // part of Nextflow's own console output.
            def console = workflow.stdout.join('\n')

            assertAll(
                { assert workflow.failed },
                { assert console.contains('non-unique gene_name <-> gene_id mapping') },
                { assert console.contains('HLA-A  ENSG_HLA_A, ENSG_HLA_A_DUP   duplicated_gene_name') },
                // Both failure directions are reported, uncapped.
                { assert console.contains('ENSG_MIC_SHARED') },
                { assert console.contains('duplicated_gene_id') },
                // errorStrategy 'terminate' plus the ch_gtf_checked gate: no
                // reconciliation output can be produced from a rejected GTF.
                { assert !new File("$outputDir/hla_readcount_reconcile").exists() }
            )
        }
    }

    test("reject mismatched extracted FASTQ pair") {

        // This is the only test that actually invokes validatefastq (every
        // other test either fails at parameter/samplesheet validation or runs
        // -stub-run). It therefore uses a config that enables a container
        // engine on top of conf/test.config, so ARCASHLA_VALIDATE_FASTQ
        // provisions the validator from its own container directive instead of
        // relying on a host-installed executable - which is the whole point of
        // that module's environment.yml/container pairing.
        config "../tests/singularity.config"

        when {
            params {
                rna_samples = "$projectDir/tests/fixtures/rna_samples_invalid_pair.csv"
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                // Intended failure is arcasHLA's own validatefastq pairing
                // check ('Sequence headers do not match'). COUNTS_COMMONREF
                // (independent of ARCASHLA, per docs/usage.md#whole-genome-common-reference-gene-counts)
                // now also runs immediately in parallel and, in this
                // container-less/conda-less nf-test environment, fails
                // first with a 'featureCounts: command not found' exit
                // (expected: SUBREAD_FEATURECOUNTS is not covered by the
                // operator-prepared Conda environment, same as STAR above -
                // see usage docs). Either failure correctly demonstrates
                // `workflow.failed` for this invalid-pair fixture; accepting
                // both keeps this assertion deterministic without depending
                // on inter-process scheduling order.
                { assert workflow.stdout.any { it.contains('Sequence headers do not match') || it.contains('featureCounts: command not found') } }
            )
        }
    }
}
