#!genome-build fixture
#!genome-version fixture
# Real GRCh38 MHC coordinates, so -profile test's default
# --hla_region chr6:28500000-33400000 applies unchanged.
chr6	fixture	gene	29942532	29945870	.	+	.	gene_id "ENSG_HLA_A"; gene_name "HLA-A";
chr6	fixture	exon	29942532	29945870	.	+	.	gene_id "ENSG_HLA_A"; gene_name "HLA-A";
# Deliberately carries a DIFFERENT gene_id from the HLA-A gene row above: only
# feature_type == "gene" rows are counted, so this must not look like a
# duplicate.
chr6	fixture	transcript	29942532	29945870	.	+	.	gene_id "ENSG_HLA_A_NOT_A_GENE_ROW"; gene_name "HLA-A";
chr6	fixture	gene	31353875	31357188	.	-	.	gene_id "ENSG_HLA_B"; gene_name "HLA-B";
chr6	fixture	gene	31399784	31415315	.	+	.	gene_id "ENSG_MICA"; gene_name "MICA";
chr1	fixture	gene	1000	2000	.	+	.	gene_id "ENSG_GENE_X"; gene_name "GENE_X";
