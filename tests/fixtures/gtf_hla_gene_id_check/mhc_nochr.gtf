#!genome-build fixture
#!genome-version fixture
# mhc_unique.gtf with its MHC contig renamed chr6 -> 6 (Ensembl naming). Run
# with --hla_region chr6:28500000-33400000 it is a certain chr/no-chr naming
# mismatch, which check_gtf_hla_gene_ids.py rejects with exit status 3.
6	fixture	gene	29942532	29945870	.	+	.	gene_id "ENSG_HLA_A"; gene_name "HLA-A";
6	fixture	exon	29942532	29945870	.	+	.	gene_id "ENSG_HLA_A"; gene_name "HLA-A";
# Deliberately carries a DIFFERENT gene_id from the HLA-A gene row above: only
# feature_type == "gene" rows are counted, so this must not look like a
# duplicate.
6	fixture	transcript	29942532	29945870	.	+	.	gene_id "ENSG_HLA_A_NOT_A_GENE_ROW"; gene_name "HLA-A";
6	fixture	gene	31353875	31357188	.	-	.	gene_id "ENSG_HLA_B"; gene_name "HLA-B";
6	fixture	gene	31399784	31415315	.	+	.	gene_id "ENSG_MICA"; gene_name "MICA";
chr1	fixture	gene	1000	2000	.	+	.	gene_id "ENSG_GENE_X"; gene_name "GENE_X";
