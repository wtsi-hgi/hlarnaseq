/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for collecting per-task resource usage
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Opt-in only - not loaded by nextflow.config. Pass it at launch:

        nextflow run wtsi-hgi/hlarnaseq ... -c conf/resources.config

    Extends the default execution trace (written to
    ${params.outdir}/pipeline_info/execution_trace_<suffix>.txt) with the
    *requested* resources (cpus, memory, time) next to what each task actually
    used, and writes raw values (milliseconds, bytes, plain %cpu numbers)
    instead of human-readable ones ("1m 58s", "7.6 MB"), so the file can be
    loaded directly for analysis.

    Summarise the resulting trace file with:

        scripts/resource_stats.py <execution_trace.txt> --outdir <dir>
----------------------------------------------------------------------------------------
*/

trace {
    enabled   = true
    overwrite = true
    raw       = true   // milliseconds and bytes instead of "1m 58s" / "7.6 MB"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,queue,cpus,memory,time,submit,start,complete,duration,realtime,%cpu,%mem,peak_rss,peak_vmem,rss,vmem,rchar,wchar,read_bytes,write_bytes,cpu_model'
}
