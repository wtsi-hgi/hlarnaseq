/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests of the HIBAG path
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same as `test`, but calls genotype-side HLA alleles from SNP-array data
    with HIBAG instead of from WGS with HLA-LA. The two are mutually exclusive,
    so `wgs_samples` stays null here.

    Use as follows:
        nextflow run wtsi-hgi/hlarnaseq -profile test_hibag --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'HIBAG test profile'
    config_profile_description = 'Minimal test dataset to check the HIBAG SNP-array path'

    // Input data
    rna_samples = "${projectDir}/tests/fixtures/rna_samples.csv"
    hla_region  = 'chr6:28500000-33400000'
    wgs_samples = null
    sample_key  = "${projectDir}/tests/fixtures/sample_key_empty.csv"
    hlapm_repo  = "${projectDir}/tests/fixtures/hlapm_repo_stub"
    arcashla_reference_dir = "${projectDir}/tests/fixtures/arcashla_reference_stub"
    gtf         = "${projectDir}/tests/fixtures/placeholder.gtf"

    // SNP-array / HIBAG
    array_samples = "${projectDir}/tests/fixtures/hibag/array_samples.csv"
    hibag_model   = "${projectDir}/tests/fixtures/hibag/ModelList.RData"

    // The bundled HIBAG example model stores SNP positions exactly 1 bp below
    // the Illumina manifest coordinates the fixture genotypes use, so every
    // position-based criterion matches nothing and only rsID matching works.
    // See tests/fixtures/hibag/README.md. Real runs against a model built for
    // the operator's own array should keep the stricter default.
    hibag_match_type = 'RefSNP'
    hibag_assembly   = 'hg19'
}
