/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PLACEHOLDER - this is not yet a working full-size test profile.

    A real `test_full` profile needs a full-size, publicly reachable dataset:
    an RNA samplesheet of whole-genome, coordinate-sorted BAMs plus paired
    unaligned reads, a matching `--sample_key`, a whole-genome `--gtf`, and a
    built arcasHLA reference (`--arcashla_reference_dir`). None of that exists
    for this pipeline yet, so no input parameters are set here.

    It is deliberately NOT pointed at `-profile test`'s fixtures: those are
    deliberately tiny, carry no real HLA allele signal, and dressing them up as
    a full-size test would make this profile lie about what it proves.

    Consequence: `-profile test_full` fails immediately at parameter validation
    with nf-schema's `Missing required parameter(s): ...`. That is intended
    until a genuine full-size dataset is sourced (a separate to-do). The file,
    its `test_full` entry in `nextflow.config`, and
    `.github/workflows/awsfulltest.yml` are all kept in place so nf-core lint's
    `files_exist`/`actions_awsfulltest` checks stay valid.

    Use as follows:
        nextflow run wtsi-hgi/hlarnaseq -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'PLACEHOLDER - no full-size dataset is configured yet, see conf/test_full.config'

    // Input data for full size test - intentionally unset until a full-size
    // dataset is sourced. Set rna_samples, sample_key, hla_region, gtf and
    // arcashla_reference_dir here at that point.
}
