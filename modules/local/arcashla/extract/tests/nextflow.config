// ARCASHLA_EXTRACT declares its own conda/container environment, so this test
// must run under a container engine - nf-test.config pins `profile "test"`,
// which enables no engine at all, and without this the test would silently
// resolve samtools from the host PATH (where an older samtools may well exist)
// and prove nothing about the pinned image. nf-test 0.9.5 has no per-test
// `profile` directive, so a per-test config is how a single test opts into an
// engine. Singularity, matching modules/local/hibag/predict/tests and
// modules/local/arcashla/genotype/tests.
singularity.enabled    = true
singularity.autoMounts = true
conda.enabled          = false
docker.enabled         = false
