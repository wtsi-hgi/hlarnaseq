#!/usr/bin/env bash
# Run nf-core/hlarnaseq in the foreground with -profile singularity,sanger.
#
# All arguments are passed through to `nextflow run` unchanged, so anything
# valid on a bare `nextflow run` command line works here. Use hlarnaseq-bsub
# to put the Nextflow head process on LSF instead of your login session.
set -euo pipefail

# Resolve symlinks before looking for lib/common.sh: these commands may be
# reached through a symlink farm rather than directly on PATH, and plain
# dirname on BASH_SOURCE would then point at the farm, not at the deploy tree.
# Inlined rather than shared because this runs before common.sh is available.
_self="${BASH_SOURCE[0]}"
if readlink -f / >/dev/null 2>&1; then
    _self="$(readlink -f -- "${_self}")"
fi
SCRIPT_DIR="$(cd -- "$(dirname -- "${_self}")" &>/dev/null && pwd -P)"
# shellcheck source=../lib/common.sh
source "${SCRIPT_DIR}/../lib/common.sh"

bold=""
normal=""
if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
    bold="$(tput bold 2>/dev/null || true)"
    normal="$(tput sgr0 2>/dev/null || true)"
fi

show_help() {
    sed "s/\${bold}/${bold}/g; s/\${normal}/${normal}/g" "${SCRIPT_DIR}/help.info"
}

case "${1:-}" in
-v | --version | version)
    hlarnaseq_pipeline_version
    exit 0
    ;;
-h | --help)
    show_help
    exit 0
    ;;
info | -info)
    hlarnaseq_pipeline_version
    echo
    show_help
    exit 0
    ;;
esac

if [[ $# -eq 0 ]]; then
    cat >&2 <<EOF
ERROR: no arguments given.

hlarnaseq passes its arguments straight to 'nextflow run', and this pipeline
requires at least --rna_samples, --sample_key, --gtf, --arcashla_reference_dir
and --outdir. Run 'hlarnaseq -h' for examples, or pass them in a file:

    hlarnaseq -params-file my_run.yml --outdir results

EOF
    exit 64
fi

hlarnaseq_require_launcher nextflow \
    "Load a Nextflow module first (this pipeline's manifest requires >= 25.04.0)."

hlarnaseq_export_nextflow_env
hlarnaseq_nextflow_cmd "$@"

# Report the profile that will actually be used, not the default it replaced.
profile_shown="${HLARNASEQ_PROFILE}"
if _hlarnaseq_has_profile_arg "$@"; then
    profile_shown="from your own -profile argument"
fi

# Banner on stderr so stdout stays exactly Nextflow's own output. Printed for a
# dry run too: which profile and cache a run would use is most of what anyone
# asks DRY_RUN in order to find out.
{
    echo "nf-core/hlarnaseq: ${PIPELINE_DIR}"
    echo "profile:           ${profile_shown}"
    echo "container cache:   ${NXF_SINGULARITY_CACHEDIR:-<Nextflow default>}"
    echo
} >&2

if [[ "${DRY_RUN:-0}" == "1" ]]; then
    echo "DRY_RUN=1, not executing:"
    hlarnaseq_print_cmd "${HLARNASEQ_CMD[@]}"
    exit 0
fi

exec "${HLARNASEQ_CMD[@]}"
